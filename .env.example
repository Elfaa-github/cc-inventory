# Salin file ini menjadi .env lalu ganti nilainya
DB_NAME=inventory
DB_USER=inventory_app
DB_PASSWORD=ganti-dengan-password-kuat
DB_ROOT_PASSWORD=ganti-dengan-password-root-kuat
# Nama image API. Ganti <ACCOUNT_ID> dengan Account ID AWS-mu untuk push ke ECR.
API_IMAGE=<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/inventory-api:latest
